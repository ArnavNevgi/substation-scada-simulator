  "propConfig": {
    "custom.sldUsable": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(if(isGood({[default]Substation/Health/Telemetry_Usable}), !isNull({[default]Substation/Health/Telemetry_Usable}), false) && if(isGood({[default]Substation/Health/Communications_Healthy}), !isNull({[default]Substation/Health/Communications_Healthy}), false) && if(isGood({[default]Substation/Status/Model_Valid}), !isNull({[default]Substation/Status/Model_Valid}), false) && if(isGood({[default]Substation/Status/Grid_Available}), !isNull({[default]Substation/Status/Grid_Available}), false) && if(isGood({[default]Substation/Status/CB1_Closed}), !isNull({[default]Substation/Status/CB1_Closed}), false) && if(isGood({[default]Substation/Status/Trip_Latched}), !isNull({[default]Substation/Status/Trip_Latched}), false) && if(isGood({[default]Substation/Status/PV_Running}), !isNull({[default]Substation/Status/PV_Running}), false) && if(isGood({[default]Substation/Status/PV_Tripped}), !isNull({[default]Substation/Status/PV_Tripped}), false) && if(isGood({[default]Substation/Status/Bus_Energized}), !isNull({[default]Substation/Status/Bus_Energized}), false) && if(isGood({[default]Substation/Measurements/Grid_P_kW}), !isNull({[default]Substation/Measurements/Grid_P_kW}), false) && if(isGood({[default]Substation/Measurements/PV_AC_Power_kW}), !isNull({[default]Substation/Measurements/PV_AC_Power_kW}), false) && if(isGood({[default]Substation/Measurements/Bus_Voltage_kV}), !isNull({[default]Substation/Measurements/Bus_Voltage_kV}), false) && if(isGood({[default]Substation/Measurements/T1_Loading_pct}), !isNull({[default]Substation/Measurements/T1_Loading_pct}), false) && if(isGood({[default]Substation/Measurements/Load_P_kW}), !isNull({[default]Substation/Measurements/Load_P_kW}), false), {[default]Substation/Health/Telemetry_Usable} && {[default]Substation/Health/Communications_Healthy} && {[default]Substation/Status/Model_Valid}, false)"
        }
      }
    },
    "custom.sldGridState": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if({view.custom.sldUsable}, if({[default]Substation/Status/Grid_Available}, \"AVAILABLE\", \"UNAVAILABLE\"), \"UNKNOWN\")"
        }
      }
    },
    "custom.sldCB1Position": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if({view.custom.sldUsable}, if({[default]Substation/Status/CB1_Closed}, \"CLOSED\", \"OPEN\"), \"UNKNOWN\")"
        }
      }
    },
    "custom.sldCB1Tripped": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if({view.custom.sldUsable}, {[default]Substation/Status/Trip_Latched}, false)"
        }
      }
    },
    "custom.sldCB1State": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if({view.custom.sldCB1Tripped}, \"TRIPPED / \" + {view.custom.sldCB1Position}, {view.custom.sldCB1Position})"
        }
      }
    },
    "custom.sldBusState": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if({view.custom.sldUsable}, if({[default]Substation/Status/Bus_Energized}, \"ENERGIZED\", \"DE-ENERGIZED\"), \"UNKNOWN\")"
        }
      }
    },
    "custom.sldPVState": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if({view.custom.sldUsable}, if({[default]Substation/Status/PV_Tripped}, \"TRIPPED\", if({[default]Substation/Status/PV_Running}, \"RUNNING\", \"STOPPED\")), \"UNKNOWN\")"
        }
      }
    },
    "custom.sldModelState": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if(if(isGood({[default]Substation/Health/Communications_Healthy}), !isNull({[default]Substation/Health/Communications_Healthy}), false) && if(isGood({[default]Substation/Status/Model_Valid}), !isNull({[default]Substation/Status/Model_Valid}), false), if({[default]Substation/Health/Communications_Healthy}, if({[default]Substation/Status/Model_Valid}, \"VALID\", \"INVALID\"), \"UNKNOWN\"), \"UNKNOWN\")"
        }
      }
    },
    "custom.sldGridColor": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if({view.custom.sldGridState} = \"AVAILABLE\", \"#16805D\", if({view.custom.sldGridState} = \"UNAVAILABLE\", \"#94A3B8\", \"#B45309\"))"
        }
      }
    },
    "custom.sldBusColor": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if({view.custom.sldBusState} = \"ENERGIZED\", \"#16805D\", if({view.custom.sldBusState} = \"DE-ENERGIZED\", \"#94A3B8\", \"#B45309\"))"
        }
      }
    },
    "custom.sldCB1Color": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if({view.custom.sldCB1Tripped}, \"#B91C1C\", if({view.custom.sldCB1Position} = \"CLOSED\", \"#16805D\", if({view.custom.sldCB1Position} = \"OPEN\", \"#94A3B8\", \"#B45309\")))"
        }
      }
    },
    "custom.sldPVColor": {
      "binding": {
        "type": "expr",
        "config": {
          "expression": "if({view.custom.sldPVState} = \"TRIPPED\", \"#B91C1C\", if({view.custom.sldPVState} = \"RUNNING\", \"#16805D\", if({view.custom.sldPVState} = \"STOPPED\", \"#94A3B8\", \"#B45309\")))"
        }
      }
    }
